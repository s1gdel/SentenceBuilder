<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT"
      spacing="12.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.sentencebuilder.ui.ImportController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Sentence Builder"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Select a plain-text file to validate and analyze before database integration."
           wrapText="true"/>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Text file:"/>
        <TextField fx:id="filePathField"
                   promptText="Choose or type a .txt file path"
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="browseButton"
                text="_Browse..."
                mnemonicParsing="true"
                onAction="#onBrowseFile"/>
    </HBox>

    <Label fx:id="validationLabel" wrapText="true"/>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="analyzeButton"
                text="_Analyze File"
                mnemonicParsing="true"
                defaultButton="true"
                onAction="#onAnalyzeFile"/>
        <Button fx:id="cancelButton"
                text="_Cancel"
                mnemonicParsing="true"
                onAction="#onCancelAnalysis"/>
        <ProgressBar fx:id="progressBar"
                     progress="0.0"
                     prefWidth="320.0"/>
    </HBox>

    <Label fx:id="statusLabel" wrapText="true"/>
    <Label text="Analysis summary" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="summaryArea"
              editable="false"
              focusTraversable="false"
              wrapText="true"
              VBox.vgrow="ALWAYS"/>
</VBox>
