<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sentence Builder JavaFX autocomplete layout with a text editor, ranked
  suggestions, and a choice button.
  I, Jinesh Patel (NetID: JAP220022), started this layout on October 30,
  2026 for CS4485.0W1 Senior Design, Team 25.
  I added unknown-word confirmation in the controller on November 6, 2026.
  AI prompt: Create an autocomplete-view FXML layout with a text editor,
  a ranked next-word list, selection button, and status label.
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT"
      spacing="12.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.sentencebuilder.ui.AutocompleteController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Auto-complete"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Suggestions appear only after a complete word followed by a space, period, or comma."
           wrapText="true"/>
    <Label fx:id="vocabularyLabel" wrapText="true"/>

    <Label text="Sentence text" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="sentenceArea"
              promptText="Start typing here..."
              wrapText="true"
              prefRowCount="6"
              VBox.vgrow="ALWAYS"/>

    <!-- Suggestions appear after completed words, not during partial typing. -->
    <Label text="Next-word suggestions" style="-fx-font-weight: bold;"/>
    <ListView fx:id="suggestionList" prefHeight="160.0"/>

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Button fx:id="useSuggestionButton"
                text="_Use Selected Word"
                mnemonicParsing="true"
                onAction="#onUseSuggestion"/>
    </HBox>

    <Label fx:id="statusLabel" wrapText="true"/>
</VBox>
